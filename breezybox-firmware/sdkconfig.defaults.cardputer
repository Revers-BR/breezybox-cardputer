# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
# NimBLE buffer pools, cut from the IDF defaults (MSYS_2 24, ACL 24, EVT 30,
# MAX_ACT 6) which are sized for several connections. This build makes one:
# a HID keyboard sending 8-byte reports. At the defaults the host's pools need
# ~21 KB in blocks up to ~8 KB, and on a booted full image btconnect failed
# with "hci inits failed" at free=54024 largest=16384 (after the controller had
# already released its memory). These sizes need ~9 KB.
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=20
# Features a keyboard host does not use: keyboards use legacy advertising, we
# never advertise, and DTM is an RF test mode. The peripheral role has to stay:
# the GATT server depends on it, the services menu depends on the GATT server,
# and esp_hid compiles nimble_hidh.c only when CONFIG_BT_NIMBLE_HID_SERVICE is
# set.
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
# CONFIG_BT_NIMBLE_DTM_MODE_TEST is not set
# CONFIG_BT_CTRL_DTM_ENABLE is not set
# Run the BLE controller from flash rather than ROM/IRAM. On the S3, IRAM code
# and heap share one SRAM pool. Measured: 12 KB more heap at boot, and BT init
# needs 54.7 KB instead of 59.1 KB. Cost: BT
# pauses while internal flash is erased (LittleFS or NVS writes), which a
# keyboard link rides out within its supervision timeout.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_ESP_TLS_INSECURE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=3
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_WIFI_TX_BA_WIN=3
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_LABEL=y
# 512-byte FAT sectors. SD cards use 512-byte sectors, but at the 4096 default
# every FAT buffer is 4 KB: the volume window plus one per max_files, all
# allocated when the card mounts (~37 KB for max_files=8, 7/8 of it unused).
# 4096 only matters for a wear-levelled FAT-on-flash /root, which this
# partition table does not have (LittleFS formats rather than falling back),
# so WL follows to keep that path consistent.
CONFIG_FATFS_SECTOR_512=y
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCP_OPTIONS_LEN=69
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
# Inbound TLS record buffer, halved from 16384.
#
# A single build has to run the agent as well as everything else, and this is
# the largest saving available that costs no feature: the endpoints claw talks
# to negotiate a smaller fragment happily. Frees 8 KB towards the contiguous
# memory a TLS handshake needs.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=1024
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# CONFIG_ELF_LOADER_BUS_ADDRESS_MIRROR is not set
CONFIG_ELF_LOADER_CUSTOMER_SYMBOLS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
